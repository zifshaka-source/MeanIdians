PORT=5000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:cloud

# 1. ElevenLabs Speech-to-Text (Scribe v2)
ELEVENLABS_API_KEY=

# 2. Google AI Studio API Key (Direct Gemma 4 SDK access)
GEMINI_API_KEY=

# 3. OpenRouter API Key (Fallback for Gemma 4)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it
